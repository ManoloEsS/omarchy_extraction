#!/bin/bash

if (( $# == 0 )); then
  printf 'Usage: %s <command> [args...]\n' "$0" >&2
  exit 1
fi

command_name=$(basename -- "$1")
app_id="org.desktop.$command_name"

if ! command -v ghostty >/dev/null 2>&1; then
  printf 'Terminal not found: ghostty\n' >&2
  exit 1
fi

exec setsid ghostty --class="$app_id" -e "$@"
