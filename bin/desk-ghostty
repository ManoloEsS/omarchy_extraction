#!/bin/bash

if (( $# == 0 )); then
  printf 'Usage: %s [ghostty options...]\n' "$0" >&2
  exit 1
fi

if ! command -v ghostty >/dev/null 2>&1; then
  printf 'Terminal not found: ghostty\n' >&2
  exit 1
fi

for device in /sys/class/drm/card*/device/device; do
  if [[ -r $device ]] && [[ $(<"$device") == "0x0166" ]]; then
    exec env LIBGL_ALWAYS_SOFTWARE=1 ghostty "$@"
  fi
done

exec ghostty "$@"
