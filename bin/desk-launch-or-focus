#!/bin/bash

if (( $# < 2 )); then
  printf 'Usage: %s <window-regex> -- <command> [args...]\n' "$0" >&2
  exit 1
fi

window_pattern="$1"
shift

if [[ ${1:-} == "--" ]]; then
  shift
fi

if (( $# == 0 )); then
  printf 'A launch command is required\n' >&2
  exit 1
fi

window_address=$(hyprctl clients -j 2>/dev/null | jq -r --arg pattern "$window_pattern" '
  first(.[] | select(
    (((.class // "") | test($pattern; "i"))) or
    (((.title // "") | test($pattern; "i")))
  ) | .address) // empty
')

if [[ -n $window_address ]]; then
  hyprctl dispatch focuswindow "address:$window_address"
else
  setsid -- "$@" >/dev/null 2>&1 &
fi
