#!/bin/bash

editor="${DESKTOP_EDITOR:-${EDITOR:-nvim}}"
editor_name=$(basename -- "$editor")

if ! command -v "$editor" >/dev/null 2>&1; then
  printf 'Editor not found: %s\n' "$editor" >&2
  exit 1
fi

case $editor_name in
  nvim|vim|nano|micro|hx|helix|fresh)
    exec desk-launch-tui "$editor" "$@"
    ;;
  *)
    exec setsid "$editor" "$@"
    ;;
esac
