#!/bin/bash

terminal_pid=$(hyprctl -i 0 activewindow -j 2>/dev/null | jq -r '.pid // empty' 2>/dev/null)

if [[ -z $terminal_pid ]]; then
  printf '%s\n' "$HOME"
  exit 0
fi

shell_pid=""
while IFS= read -r child_pid; do
  shell_pid="$child_pid"
done < <(pgrep -P "$terminal_pid")

if [[ -z $shell_pid ]]; then
  printf '%s\n' "$HOME"
  exit 0
fi

cwd=$(readlink -f "/proc/$shell_pid/cwd" 2>/dev/null || true)
shell=$(readlink -f "/proc/$shell_pid/exe" 2>/dev/null || true)

if [[ -n $shell ]] && grep -qs "$shell" /etc/shells && [[ -d $cwd ]]; then
  printf '%s\n' "$cwd"
else
  printf '%s\n' "$HOME"
fi
